{
  "project_id": "11938",
  "private_name": "Review_Main_400_Photos",
  "reward_per_assignment": 0.25,
  "assignment_max_duration_seconds": 300,
  "auto_accept_solutions": true,
  "filter": {
    "and": [
      {
        "or": [
          {
            "operator": "IN",
            "value": "RU",
            "key": "languages",
            "category": "profile"
          }
        ]
      },
      {
        "or": [
          {
            "key": "21781",
            "operator": "EQ",
            "value": null,
            "category": "skill"
          }
        ]
      },
      {
        "or": [
          {
            "key": "21782",
            "operator": "GTE",
            "value": 80,
            "category": "skill"
          }
        ]
      }
    ]
  },
  "quality_control": {
    "configs": [
      {
        "collector_config": {
          "type": "ASSIGNMENT_SUBMIT_TIME",
          "parameters": {
            "fast_submit_threshold_seconds": 4,
            "history_size": 5
          }
        },
        "rules": [
          {
            "conditions": [
              {
                "key": "total_submitted_count",
                "operator": "GTE",
                "value": 3
              },
              {
                "key": "fast_submitted_count",
                "operator": "GTE",
                "value": 3
              }
            ],
            "action": {
              "type": "RESTRICTION_V2",
              "parameters": {
                "duration": 10,
                "private_comment": "Слишком быстрые ответы на ревью (< 4 сек)",
                "scope": "POOL",
                "duration_unit": "DAYS"
              }
            }
          }
        ]
      },
      {
        "collector_config": {
          "type": "USERS_ASSESSMENT",
          "parameters": {}
        },
        "rules": [
          {
            "conditions": [
              {
                "key": "pool_access_revoked_reason",
                "operator": "EQ",
                "value": "RESTRICTION"
              }
            ],
            "action": {
              "type": "CHANGE_OVERLAP",
              "parameters": {
                "delta": 1,
                "open_pool": true
              }
            }
          }
        ]
      }
    ]
  },
  "defaults": {
    "default_overlap_for_new_task_suites": 2
  }
}
