      "hidden": false,
      "required": false
    },
    "image": {
      "type": "url",
      "hidden": false,
      "required": true
    },
    "photo_id": {
      "type": "string",
      "hidden": false,
      "required": true
    },
    "status_banner": {
      "type": "string",
      "hidden": false,
      "required": true
    }
  },
  "output_spec": {
    "comment": {
      "type": "string",
      "hidden": false,
      "required": false
    },
    "verdict": {
      "type": "string",
      "hidden": false,
      "required": true,
      "allowed_values": [
        "ok",
        "error_missed",
        "error_bad_box",
        "error_extra",
        "image_error"
      ]
